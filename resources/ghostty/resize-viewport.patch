+// chda ISSUE-224: a pin that becomes active must be normalized before grow.
+test "PageList chda resize newly active viewport before row growth" {
+    const testing = std.testing;
+    for ([_]bool{ true, false }) |pull| {
+        var s = try init(testing.allocator, .{ .cols = 8, .rows = 4 });
+        defer s.deinit();
+        try s.growRows(3);
+        s.scroll(.{ .pin = s.pin(.{ .screen = .{ .y = 2 } }).? });
+        try testing.expect(s.viewport == .pin);
+        try s.resize(.{ .rows = 32, .reflow = false, .pull_scrollback = pull });
+        try testing.expect(s.viewport == .active);
+        try testing.expect(s.getBottomRight(.viewport) != null);
+        try s.verifyIntegrity();
+    }
+}
+
+test "PageList chda reflow growth normalizes newly active viewport" {
+    const testing = std.testing;
+    var s = try init(testing.allocator, .{ .cols = 2, .rows = 10 });
+    defer s.deinit();
+    try s.growRows(4);
+    var it = s.pageIterator(.right_down, .{ .screen = .{} }, null);
+    while (it.next()) |chunk| {
+        const page = chunk.node.page();
+        for (chunk.start..chunk.end) |y| {
+            const rac = page.getRowAndCell(0, y);
+            rac.row.wrap = y % 2 == 0;
+            rac.row.wrap_continuation = y % 2 != 0;
+            for (0..s.cols) |x| page.getRowAndCell(x, y).cell.* = .{
+                .content_tag = .codepoint,
+                .content = .{ .codepoint = .{ .data = 'A' } },
+            };
+        }
+    }
+    s.scroll(.{ .pin = s.pin(.{ .screen = .{ .y = 2 } }).? });
+    try s.resize(.{ .cols = 4, .reflow = true });
+    try testing.expect(s.viewport == .active);
+    try testing.expect(s.getBottomRight(.viewport) != null);
+    try s.verifyIntegrity();
+}
+
+test "PageList chda row growth preserves a history viewport" {
+    const testing = std.testing;
+    var s = try init(testing.allocator, .{ .cols = 8, .rows = 4 });
+    defer s.deinit();
+    try s.growRows(40);
+    s.scroll(.{ .pin = s.pin(.{ .screen = .{ .y = 3 } }).? });
+    const before = s.viewport_pin.*;
+    try s.resize(.{ .rows = 12, .reflow = false });
+    try testing.expect(s.viewport == .pin);
+    try testing.expectEqual(before, s.viewport_pin.*);
+    try s.verifyIntegrity();
+}
+
+test "PageList chda reflow tracking allocation failure preserves viewport" {
+    const testing = std.testing;
+    var failing: std.testing.FailingAllocator = .init(testing.allocator, .{});
+    var s = try init(failing.allocator(), .{ .cols = 8, .rows = 4 });
+    defer s.deinit();
+    try s.growRows(3);
+    s.scroll(.{ .pin = s.pin(.{ .screen = .{ .y = 2 } }).? });
+    while (s.tracked_pins.count() < s.tracked_pins.capacity()) {
+        _ = try s.trackPin(s.pin(.{ .active = .{} }).?);
+    }
+    const before = s.viewport_pin.*;
+    failing.fail_index = failing.allocations;
+    try testing.expectError(error.OutOfMemory, s.resize(.{
+        .cols = 16,
+        .cursor = .{ .x = 0, .y = 0 },
+    }));
+    try testing.expectEqual(@as(usize, 8), s.cols);
+    try testing.expectEqual(before, s.viewport_pin.*);
+    try s.verifyIntegrity();
+}
