+// Resizing can move a history pin into the new active area. Until rows
+// have been grown, there may not even be enough rows for getTopLeft(.active).
+// Keep genuine history pins, but never expose the transient invalid viewport
+// to grow's integrity checks.
+fn normalizeViewportAfterResize(self: *PageList) void {
+    switch (self.viewport) {
+        .active, .top => {},
+        .pin => if (self.total_rows < self.rows or
+            self.pinIsActive(self.viewport_pin.*))
+        {
+            self.viewport = .active;
+        },
+    }
+}
