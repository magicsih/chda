# chda shell integration for zsh: semantic prompt marks (OSC 133), working
# directory reports (OSC 7) and a title (OSC 2). Safe to source by hand:
#
#   source /path/to/chda-integration

'builtin' 'autoload' '-Uz' 'add-zsh-hook'

_chda_cwd_report() {
    'builtin' 'printf' '\e]7;file://%s%s\a' "$HOST" "$PWD"
}

_chda_title() {
    'builtin' 'printf' '\e]2;%s\a' "${PWD/#$HOME/~}"
}

# A program that exits without turning mouse reporting off (interrupted,
# killed or crashed) would leave the pointer typing reports into the prompt.
# Turn off every tracking mode and encoding; programs and widgets that start
# later can request them again.
_chda_mouse_reset() {
    'builtin' 'printf' '\e[?9l\e[?1000l\e[?1002l\e[?1003l\e[?1005l\e[?1006l\e[?1015l\e[?1016l'
}

# Runs before each prompt: close the previous command's output (D), take the
# mouse back, report the directory, then mark the prompt start (A). The prompt
# end (B) is added to PS1 so the shell emits it right where input begins.
_chda_precmd() {
    'builtin' 'local' _chda_status=$?
    if (( _chda_in_command )); then
        'builtin' 'printf' '\e]133;D;%s\a' "$_chda_status"
        _chda_in_command=0
    fi
    _chda_mouse_reset
    _chda_cwd_report
    _chda_title
    'builtin' 'printf' '\e]133;A\a'
    if [[ "$PS1" != *$'%{\e]133;B\a%}'* ]]; then
        PS1="${PS1}"$'%{\e]133;B\a%}'
    fi
}

# Runs after the user hits enter: mark where command output starts (C).
_chda_preexec() {
    'builtin' 'printf' '\e]133;C\a'
    _chda_in_command=1
}

'builtin' 'typeset' '-gi' _chda_in_command=0
add-zsh-hook precmd _chda_precmd
add-zsh-hook preexec _chda_preexec

# Attach status reporting to a directly typed Codex command in chda only.
# Respect functions and aliases the user already defined in their dotfiles.
if [[ -n "${CHDA_CODEX_TITLE_CONFIG-}" && -n "${CHDA_CODEX_DAEMON_CONFIG-}" ]] && (( ! $+functions[codex] && ! $+aliases[codex] )); then
    function codex {
        if [[ -n "${CHDA_CODEX_NOTIFY_CONFIG-}" ]]; then
            'command' codex -c "$CHDA_CODEX_TITLE_CONFIG" -c "$CHDA_CODEX_DAEMON_CONFIG" -c "$CHDA_CODEX_NOTIFY_CONFIG" "$@"
        else
            'command' codex -c "$CHDA_CODEX_TITLE_CONFIG" -c "$CHDA_CODEX_DAEMON_CONFIG" "$@"
        fi
    }
fi

# Per-launch hooks and usage reporting, preserving user definitions and settings.
if [[ -n "${CHDA_HOOK_BIN-}" && -n "${CHDA_CLAUDE_BINARY-}" ]] && (( ! $+functions[claude] && ! $+aliases[claude] )); then
    function claude {
        'builtin' 'local' _chda_settings
        _chda_settings=$("$CHDA_HOOK_BIN" agent-settings claude) || return $?
        'command' "$CHDA_CLAUDE_BINARY" --settings "$_chda_settings" "$@"
    }
fi
